# Environment configuration (placeholders only)
# DO NOT commit real secrets. Use Vercel / Supabase project settings for production secrets.

# App
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Supabase (public keys allowed on client; service role MUST be server-only)
NEXT_PUBLIC_SUPABASE_URL=https://xyz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pk.XXXXXXXXXXXXXXXXXXXXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=sk.XXXXXXXXXXXXXXXXXXXXXXXXXXXX   # server-only, NEVER expose to client
SUPABASE_DB_URL=postgres://user:pass@host:port/dbname           # optional, if used server-side

# Razorpay (server-only secrets must not be exposed)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=rzp_test_secret_xxxxxxxxxxxx               # server-only
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxx              # server-only

# OTP / SMS providers (optional)
MSG91_API_KEY=msg91_xxxxxxxxxxxxxxxxx
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email provider (optional)
RESEND_API_KEY=or-keep-empty

# Monitoring (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Local dev
NODE_ENV=development

# Notes:
# - Keep a separate .env.local for local development which is gitignored.
# - Never commit SUPABASE_SERVICE_ROLE_KEY, RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to the repository.
